{
  "name": "resepsionis-virtual-pupr",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "onnxruntime-node": "^1.31.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pupr.resepsionis",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
