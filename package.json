{
  "name": "resepsionis-virtual-pupr",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:backend": "node scripts/build-backend.js",
    "build:win": "npm run build:backend && electron-builder --win nsis",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {
    "onnxruntime-node": "^1.31.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pupr.resepsionis",
    "productName": "Resepsionis Virtual PUPR",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app-files",
        "filter": [
          "index.html",
          "preload.js",
          "app.config.json",
          "server_stt.py",
          "server_stt.exe",
          "requirements.txt",
          "src/**/*",
          "public/**/*",
           "scripts/**/*",
           "python/**/*",
           "python-runtime/**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/dist-electron/**",
          "!**/.tts-cache/**",
          "!**/*.wav",
          "!**/*.mp3",
          "!**/.env",
          "!**/speakers.pth",
          "!**/*.db",
          "!**/__pycache__/**"
        ]
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
