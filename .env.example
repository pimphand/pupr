# PUPR local fallback env (optional).
# Konfigurasi AI (system prompt, limits, model) diambil server_stt.py dari DASHBOARD_CONFIG_URL saat startup.
# Semua panggilan AI/chat lewat dashboard (DASHBOARD_CONFIG_URL -> .../api/pupr/chat); backend tidak
# menyimpan API key provider LLM dan tidak memanggil Cloudflare/Gemini/OpenAI secara langsung.
# Use localhost (works when Astro dev binds IPv6 ::1 or IPv4 127.0.0.1)
DASHBOARD_CONFIG_URL=
DASHBOARD_CONFIG_TOKEN=
# Provider LLM (Cloudflare run URL + model) hanya dari dashboard DB (public.pupr_cloudflare_provider).
# Jangan mengandalkan default/hardcode env untuk URL atau model provider.
# Interval refresh config AI dari dashboard (detik; 0 = setiap request). Default 30 bila tidak diisi.
# DASHBOARD_CONFIG_REFRESH_SECONDS=30

# --- TTS (remote DataByte / ElevenLabs gateway) ---
# Backend proxy: POST /tts -> https://ai.databyte.co.id/gateway/v1/audio/speech (audio/mpeg)
TTS_PROVIDER=
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

# Endpoint chat dashboard (opsional; default diturunkan dari DASHBOARD_CONFIG_URL).
# DASHBOARD_CHAT_URL=https://pupr.pemdeslobar.com/api/pupr/chat


# URL layanan TTS/AI backend (server_stt.py).
# Docker: jalankan `docker compose up -d --build` di folder tts/, lalu pakai URL publish-nya.
# Lokal (tanpa Docker): http://127.0.0.1:8767 dan set PUPR_BACKEND_AUTOSTART=true.
TTS_URL=http://127.0.0.1:8767

# false = jangan spawn backend Python lokal (backend sudah jalan di Docker).
PUPR_BACKEND_AUTOSTART=false
