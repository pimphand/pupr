# PUPR local fallback env (optional).
# API keys utama sekarang disimpan di Dashboard DB (public.app_settings, key: pupr.api_keys)
# dan diambil oleh server_stt.py dari DASHBOARD_CONFIG_URL saat startup.
# Dashboard harus berjalan agar backend PUPR bisa mengambil key terbaru.
DASHBOARD_CONFIG_URL=http://127.0.0.1:4321/api/pupr/config
# DASHBOARD_CONFIG_TOKEN=

OPENAI_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
