[TEMPLATE]
# Env backend PUPR (tts/server_stt.py). Dipakai baik saat jalan lokal maupun di Docker
# (docker-compose.yml memuat file ini bila ada: `cp .env.example .env`).
# API keys utama disimpan di Dashboard DB (public.app_settings, key: pupr.api_keys) dan diambil
# server_stt.py dari DASHBOARD_CONFIG_URL saat startup. Dashboard harus berjalan.

# Di Docker, 127.0.0.1 menunjuk ke container itu sendiri, bukan ke host.
# Gunakan host.docker.internal (sudah di-mapping oleh docker-compose.yml).
# Untuk akses lintas container (satu network compose), pakai mis. http://dashboard:4321/api/pupr/config
DASHBOARD_CONFIG_URL=http://host.docker.internal:4321/api/pupr/config
# DASHBOARD_CONFIG_TOKEN=

# Provider LLM (Cloudflare run URL + model) WAJIB diatur di dashboard DB: public.pupr_cloudflare_provider.
# Backend tidak memakai default/hardcoded env untuk run URL maupun model provider.

# Batas waktu (detik) request konfigurasi ke dashboard
DASHBOARD_CONFIG_TIMEOUT=4
# Interval ambil ulang config terbaru dari dashboard (detik; 0 = setiap request). Default 30.
DASHBOARD_CONFIG_REFRESH_SECONDS=30

# Bind server. Di Docker selalu 0.0.0.0:8767 (port host diatur compose).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8767
# Izinkan /api-status & /api-config dari loopback/private network (wajib untuk Docker).
# Request dari network publik/Cloudflare tetap ditolak 403.
PUPR_ALLOW_REMOTE_API=1

# Endpoint chat/AI dashboard (satu-satunya jalur keluar AI dari backend ini).
# Default: diturunkan otomatis dari DASHBOARD_CONFIG_URL -> https://.../api/pupr/chat
# DASHBOARD_CHAT_URL=https://pupr.pemdeslobar.com/api/pupr/chat
# DASHBOARD_CHAT_TIMEOUT=60
# DASHBOARD_USAGE_URL / DASHBOARD_CONVERSATION_URL juga diturunkan otomatis bila kosong.
# Tidak ada API key provider LLM di sini: key dikelola dashboard, backend tidak menyimpannya.

# Text to speech. Provider aktif: cloudflare (default), google, atau databyte.
# google = Google Translate TTS: gratis, tanpa API key, punya voice bahasa Indonesia (id/en/...).
#   Teks dipecah otomatis <=180 karakter per request karena batas endpoint Google.
#   Set TTS_PROVIDER=google (env) atau ttsProvider=google di dashboard untuk memakainya.
#   TTS_GOOGLE_ENABLED=0 untuk mematikan jalur ini.
# Model @cf/* (native Workers AI) memakai path per-model: POST <CLOUDFLARE_URL>/@cf/deepgram/aura-1
#   body {"text": ..., "speaker": ...}  -> audio/mpeg biner
# Model partner (mis. google/...) memakai endpoint unified: {"model": ..., "input": {"text": ..., "voice": ...}}
#   Model TTS Google (google/gemini-3.8-flash-tts) memakai voice Gemini: Kore, Puck, Zephyr, Leda, ...
#   Catatan: di akun ini model tersebut masih membalas 500 "Model execution failed (Error)", sehingga
#   backend otomatis memakai Google Translate TTS (voice Indonesia) sebagai cadangan.
# Voice Aura: angus, asteria, arcas, orion, orpheus, athena, luna, zeus, perseus, helios, hera, stella
# MeloTTS (@cf/myshell-ai/melotts): body {"prompt": ..., "lang": en|es|fr|jp|kr|zh} -> JSON base64 (WAV).
#   MeloTTS belum mendukung bahasa Indonesia; teks Indonesia akan dibaca dengan pelafalan Inggris.
# CLOUDFLARE_ACCOUNT_ID/CLOUDFLARE_API_TOKEN di sini dipakai bila dashboard belum mengirimkannya.
# Run URL utama tetap dari dashboard (public.pupr_cloudflare_provider); CLOUDFLARE_URL adalah fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/run
CLOUDFLARE_MODEL=@cf/deepgram/aura-1
CLOUDFLARE_VOICE=asteria
# CLOUDFLARE_LANG=en
TTS_PROVIDER=cloudflare
# Bahasa TTS: id (default) mengarahkan teks Indonesia ke gateway ElevenLabs (DataByte), sedangkan
# en memakai Cloudflare Aura. Cloudflare Workers AI belum punya voice bahasa Indonesia.
# TTS_LANG=id
# Model TTS Cloudflare hanya menerima model Workers AI native (@cf/...); nilai lain diabaikan
# supaya field ttsModel dashboard yang berisi model provider lain tidak membuat request 400.

# Gateway DataByte (lama). Dipakai otomatis bila kredensial Cloudflare belum tersedia.
# TTS_API_URL=https://ai.databyte.co.id/gateway/v1/audio/speech
# TTS_API_KEY=
# TTS_MODEL=elevenlabs/eleven-v3-conversational
# TTS_VOICE=brian
# TTS_TIMEOUT=60
